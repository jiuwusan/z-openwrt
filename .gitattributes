# 默认：按内容自动识别文本/二进制，文本文件提交时统一为 LF
* text=auto eol=lf

# 明确的文本类型：仓库内与检出后都强制 LF（部署到 Linux 设备的文件绝不能是 CRLF）
*.sh        text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf
files/etc/** text eol=lf

# Windows 专用的脚本/文件保持 CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 明确的二进制类型：禁止任何换行符转换
*.bin    binary
*.img    binary
*.gz     binary
*.zip    binary
*.tar    binary
*.png    binary
*.jpg    binary
*.pdf    binary
