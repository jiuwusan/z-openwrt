#!/bin/sh /etc/rc.common
# bypass-network-detect
#
# 用途：设备作为二级路由接入上级路由时，开机自动探测上游网段，为 LAN 口
# 选择一个与上游同网段且未被占用的静态地址，并写入 UCI（network + dhcp），
# 避免默认网段（如 192.168.1.x）与上游冲突导致无法上网。
#
# 整体流程（见 detect）：
#   1. 加锁防并发（mkdir 原子操作）。
#   2. 若现有配置的网关可达、且本机 IP 无冲突，则只刷新 DNS/DHCP 选项。
#   3. 否则遍历常见家用路由网关地址：先用随机地址探测确认网段活跃，
#      再从 .99 向 .2 递减选一个空闲 IP，写入静态配置并重启 network/dnsmasq。
#   4. 所有网关都探测失败则保持原配置不动。

START=99
STOP=10
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOCK_DIR=/var/run/bypass-network-detect.lock

log() { logger -t bypass-network-detect "$*"; }
cleanup() { rmdir "$LOCK_DIR" 2>/dev/null || true; }
valid_ipv4() { echo "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; }

# 判断地址是否已经配置在本机接口上。无 arping 时，ping 本机地址会成功，
# 必须先排除这种情况，否则当前地址会被误判为冲突。
local_address() {
    candidate=$1
    ip -4 addr show dev "$DEVICE" 2>/dev/null |
        awk '/inet / { sub(/\/.*/, "", $2); print $2 }' |
        grep -Fxq "$candidate"
}

# 经指定接口 ping 目标（1 包、1 秒超时），用于判断网关是否可达
gateway_up() {
    ping -c 1 -W 1 -I "$DEVICE" "$1" >/dev/null 2>&1
}

# 判断候选地址是否空闲（无其他主机占用）
address_free() {
    candidate=$1
    ADDRESS_CHECK_RESULT=free
    if command -v arping >/dev/null 2>&1; then
        # arping -D 为重复地址检测：有应答说明地址已被占用。
        # 退出码 0 = 无人应答 = 空闲；1 = 已被占用；其他为出错。
        arping -D -I "$DEVICE" -c 2 -w 1 "$candidate" >/dev/null 2>&1
        result=$?
        [ "$result" -eq 0 ] && return 0
        if [ "$result" -eq 1 ]; then
            ADDRESS_CHECK_RESULT=busy
        else
            ADDRESS_CHECK_RESULT=error
            log "arping failed for $candidate (exit $result)"
        fi
        return 1
    fi

    # 无 arping 的固件走弱一级的兜底：已有邻居表项、或 ping 有响应，
    # 都说明地址已被占用。检测阶段会在日志中提示此方式较弱。
    local_address "$candidate" && return 0
    if ip neigh show dev "$DEVICE" "$candidate" 2>/dev/null | grep -q 'lladdr'; then
        ADDRESS_CHECK_RESULT=busy
        return 1
    fi
    if ping -c 1 -W 1 -I "$DEVICE" "$candidate" >/dev/null 2>&1; then
        ADDRESS_CHECK_RESULT=busy
        return 1
    fi
    return 0
}

# 网段试探：临时把 candidate 以 /24 别名挂到接口上，ping 网关验证连通，
# 结束时无论成败都撤掉别名。成功返回 0 表示该网段（网关）确实活跃。
# 失败时置 ADDRESS_BUSY=1，用于区分「候选被占用」和「网关不可达」：
# 只有前者才值得进入顺序扫描，后者说明网段根本不存在。
temporary_probe() {
    gw=$1
    ip=$2
    PROBE_RESULT=error
    if [ "${3:-}" != already_free ]; then
        if ! address_free "$ip"; then
            [ "$ADDRESS_CHECK_RESULT" = busy ] && PROBE_RESULT=busy
            return 1
        fi
    fi
    ip -4 addr add "$ip/24" dev "$DEVICE" label "$DEVICE:detect" 2>/dev/null || return 1
    if gateway_up "$gw"; then
        ip -4 addr del "$ip/24" dev "$DEVICE" 2>/dev/null
        PROBE_RESULT=ok
        return 0
    fi
    ip -4 addr del "$ip/24" dev "$DEVICE" 2>/dev/null
    PROBE_RESULT=unreachable
    return 1
}

# 生成 2-99 的随机主机号：优先读 /dev/urandom 2 字节，失败退化为 PID+RANDOM
random_host() {
    if [ -r /dev/urandom ]; then
        value=$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ')
        case "$value" in
            ''|*[!0-9]*) ;;
            *) echo $((value % 98 + 2)); return 0 ;;
        esac
    fi
    echo $((($$ + ${RANDOM:-0}) % 98 + 2))
}

# 从当前接口的默认路由提取上游网关；固定列表仅作为兜底。
discover_gateway() {
    ip -4 route show default dev "$DEVICE" 2>/dev/null |
        awk '$1 == "default" { for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }'
}

# 用随机地址探测网段，最多 3 次；避免对每个错误网关都全量扫描 .99-.2。
# 返回 1 时若 PROBE_RESULT=busy，说明随机候选均被占用（网段大概率活跃），
# 值得顺序扫描；其他结果表示探测失败，应直接跳过，避免在异常接口上长时间扫描。
probe_subnet_randomly() {
    gw=$1
    prefix=${gw%.*}
    attempt=1
    while [ "$attempt" -le 3 ]; do
        host=$(random_host)
        candidate="$prefix.$host"
        if temporary_probe "$gw" "$candidate"; then
            return 0
        fi
        [ "$PROBE_RESULT" = busy ] || return 1
        attempt=$((attempt + 1))
    done
    return 1
}

# 随机探测全被占用时的确定性兜底：从 .99 向 .2 递减扫描
probe_subnet_sequentially() {
    gw=$1
    prefix=${gw%.*}
    host=99
    while [ "$host" -ge 2 ]; do
        if address_free "$prefix.$host"; then
            if temporary_probe "$gw" "$prefix.$host" already_free; then
                return 0
            fi
        fi
        [ "$ADDRESS_CHECK_RESULT" = busy ] || return 1
        host=$((host - 1))
    done
    return 1
}

# 网段已确认后，从 .99 向 .2 递减选第一个空闲地址；
# 此时只做地址冲突检测，不再重复探测网关
select_free_address() {
    prefix=$1
    host=99
    while [ "$host" -ge 2 ]; do
        candidate="$prefix.$host"
        if address_free "$candidate"; then
            SELECTED_IP=$candidate
            return 0
        fi
        host=$((host - 1))
    done
    return 1
}

# 值未变化时跳过写入，避免无谓的 UCI 提交和 NETWORK_CHANGED 误置位
set_network_option() {
    key=$1
    value=$2
    [ "$(uci -q get "$key" || true)" = "$value" ] && return 0
    uci set "$key=$value"
    NETWORK_CHANGED=1
}

# 把选定的新网关/本机地址写入 UCI：
#   network.lan -> 静态地址、掩码、网关、multipath off、DNS 列表
#   dhcp.lan    -> DHCP 选项 3（网关）和 6（DNS）指向本机 LAN IP，
#                  其余自定义 dhcp_option 原样保留
# 只有实际发生变更才 commit 对应配置；commit 失败返回 1。
configure() {
    gw=$1
    ip=$2
    NETWORK_CHANGED=0
    DHCP_CHANGED=0

    set_network_option network.lan.proto static
    set_network_option network.lan.device "$DEVICE"
    set_network_option network.lan.ipaddr "$ip"
    set_network_option network.lan.netmask 255.255.255.0
    set_network_option network.lan.gateway "$gw"
    set_network_option network.lan.multipath off

    # DNS：上游网关 + 两个公共 DNS（DNSPod / AliDNS）
    wanted_dns="$gw 119.29.29.29 223.5.5.5"
    if [ "$(uci -q get network.lan.dns || true)" != "$wanted_dns" ]; then
        uci -q delete network.lan.dns
        uci -q add_list network.lan.dns="$gw"
        uci -q add_list network.lan.dns=119.29.29.29
        uci -q add_list network.lan.dns=223.5.5.5
        NETWORK_CHANGED=1
    fi

    # DHCP option 3 = 下发给客户端的网关；option 6 = 下发的 DNS。
    # start=100 / limit=150 不用改，它们天然基于当前选中的子网。
    if uci -q get dhcp.lan >/dev/null 2>&1; then
        current_options=$(uci -q get dhcp.lan.dhcp_option || true)
        kept_options=
        for option in $current_options; do
            case "$option" in
                3,*|6,*) ;;                      # 旧的 3/6 选项丢弃，下面重建
                *) kept_options="$kept_options $option" ;;
            esac
        done
        wanted_options="${kept_options# } 3,$ip 6,$ip"
        wanted_options=${wanted_options# }
        if [ "$current_options" != "$wanted_options" ]; then
            uci -q delete dhcp.lan.dhcp_option
            for option in $wanted_options; do
                uci -q add_list dhcp.lan.dhcp_option="$option"
            done
            DHCP_CHANGED=1
        fi
    fi

    [ "$NETWORK_CHANGED" -eq 0 ] || uci commit network || return 1
    [ "$DHCP_CHANGED" -eq 0 ] || uci commit dhcp || return 1
    log "selected gateway=$gw lan_ip=$ip"
}

detect() {
    DEVICE="$(uci -q get network.lan.device || true)"
    [ -n "$DEVICE" ] || DEVICE=br-lan
    command -v arping >/dev/null 2>&1 || log "arping not installed; using weaker IP/neighbour fallback"

    # mkdir 抢锁（原子）；失败时检查锁内 PID 是否存活，清理陈旧锁
    # （SIGKILL/断电留下的残留，否则本次开机检测永久失效）
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        stale_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
        if [ -n "$stale_pid" ] && [ -d "/proc/$stale_pid" ]; then
            log "already running (pid $stale_pid)"
            return 0
        fi
        log "removing stale lock (pid ${stale_pid:-unknown})"
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" 2>/dev/null || { log "cannot acquire lock"; return 0; }
    fi
    echo $$ > "$LOCK_DIR/pid"
    trap cleanup EXIT INT TERM

    # 快路径：现有配置有效（IP/网关格式合法、网关可达、本机 IP 无冲突）
    # 则不换网段，仅刷新 DHCP/DNS 选项后直接返回
    current_ip=$(uci -q get network.lan.ipaddr || true)
    current_gw=$(uci -q get network.lan.gateway || true)
    if valid_ipv4 "$current_ip" && valid_ipv4 "$current_gw" && gateway_up "$current_gw" && address_free "$current_ip"; then
        log "current gateway $current_gw is reachable"
        if configure "$current_gw" "$current_ip"; then
            [ "$NETWORK_CHANGED" -eq 0 ] || /etc/init.d/network restart >/dev/null 2>&1
            [ "$DHCP_CHANGED" -eq 0 ] || /etc/init.d/dnsmasq restart >/dev/null 2>&1
        else
            log "failed to refresh DHCP options"
        fi
        return 0
    fi

    # 慢路径：遍历常见家用路由网关地址，按常见程度从高到低排列
    DISCOVERED_GATEWAY=$(discover_gateway)
    valid_ipv4 "$DISCOVERED_GATEWAY" || DISCOVERED_GATEWAY=
    GATEWAYS="$DISCOVERED_GATEWAY 192.168.1.1 192.168.0.1 192.168.3.1 192.168.31.1 192.168.50.1 192.168.68.1 192.168.100.1"
    SEEN_GATEWAYS=
    for gw in $GATEWAYS; do
        case " $SEEN_GATEWAYS " in
            *" $gw "*) continue ;;
        esac
        SEEN_GATEWAYS="$SEEN_GATEWAYS $gw"
        prefix=${gw%.*}
        # 先用最多 3 次随机探测确认网段活跃。仅当随机候选均被占用
        # （PROBE_RESULT=busy）才顺序扫描；其他失败直接跳过，
        # 避免每个错误网关都耗时的全量扫描。
        if ! probe_subnet_randomly "$gw"; then
            [ "$PROBE_RESULT" = busy ] || continue
            # 随机候选都被占用时，退化为确定性递减扫描
            probe_subnet_sequentially "$gw" || continue
        fi

        # 网段已确认：网关连通性在上面已验证，
        # 这里只需挑一个空闲地址并写入配置
        if select_free_address "$prefix"; then
            if configure "$gw" "$SELECTED_IP"; then
                /etc/init.d/network restart >/dev/null 2>&1
                /etc/init.d/dnsmasq restart >/dev/null 2>&1
                return 0
            fi
            log "could not commit configuration for $gw/$SELECTED_IP"
        fi
    done

    log "no known upstream gateway reachable; keeping existing configuration"
    return 1
}

# 开机时等 3 秒让网络栈/接口就绪后再探测
boot() {
    sleep 3
    detect
}

start() { boot; }
