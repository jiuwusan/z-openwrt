#!/bin/sh /etc/rc.common

START=99
STOP=10
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOCK_DIR=/var/run/bypass-network-detect.lock

log() { logger -t bypass-network-detect "$*"; }
cleanup() { rmdir "$LOCK_DIR" 2>/dev/null || true; }
valid_ipv4() { echo "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; }

gateway_up() {
    ping -c 1 -W 1 -I "$DEVICE" "$1" >/dev/null 2>&1
}

address_free() {
    candidate=$1
    if command -v arping >/dev/null 2>&1; then
        # Duplicate-address detection: a reply means the candidate is used.
        arping -D -I "$DEVICE" -c 2 "$candidate" >/dev/null 2>&1
        return $?
    fi

    # Fallback for images without arping.  An existing neighbour entry or a
    # successful probe means the address is already in use.  This is weaker
    # than arping, so the log calls it out during detection.
    if ip neigh show dev "$DEVICE" "$candidate" 2>/dev/null | grep -q 'lladdr'; then
        return 1
    fi
    ping -c 1 -W 1 -I "$DEVICE" "$candidate" >/dev/null 2>&1 && return 1
    return 0
}

temporary_probe() {
    gw=$1
    ip=$2
    address_free "$ip" || return 1
    ip -4 addr add "$ip/24" dev "$DEVICE" label "$DEVICE:detect" 2>/dev/null || return 1
    if gateway_up "$gw"; then
        ip -4 addr del "$ip/24" dev "$DEVICE" 2>/dev/null
        return 0
    fi
    ip -4 addr del "$ip/24" dev "$DEVICE" 2>/dev/null
    return 1
}

set_network_option() {
    key=$1
    value=$2
    [ "$(uci -q get "$key" || true)" = "$value" ] && return 0
    uci set "$key=$value"
    NETWORK_CHANGED=1
}

configure() {
    gw=$1
    ip=$2
    NETWORK_CHANGED=0
    DHCP_CHANGED=0

    set_network_option network.lan.proto static
    set_network_option network.lan.device "$DEVICE"
    set_network_option network.lan.ipaddr "$ip"
    set_network_option network.lan.netmask 255.255.255.0
    set_network_option network.lan.gateway "$gw"
    set_network_option network.lan.multipath off

    wanted_dns="$gw 119.29.29.29 223.5.5.5"
    if [ "$(uci -q get network.lan.dns || true)" != "$wanted_dns" ]; then
        uci -q delete network.lan.dns
        uci add_list network.lan.dns="$gw"
        uci add_list network.lan.dns=119.29.29.29
        uci add_list network.lan.dns=223.5.5.5
        NETWORK_CHANGED=1
    fi

    # DHCP option 3 is the gateway; option 6 is the preferred DNS.
    # start=100 and limit=150 remain relative to the selected subnet.
    if uci -q get dhcp.lan >/dev/null 2>&1; then
        current_options=$(uci -q get dhcp.lan.dhcp_option || true)
        kept_options=
        for option in $current_options; do
            case "$option" in
                3,*|6,*) ;;
                *) kept_options="$kept_options $option" ;;
            esac
        done
        wanted_options="${kept_options# } 3,$ip 6,$ip"
        wanted_options=${wanted_options# }
        if [ "$current_options" != "$wanted_options" ]; then
            uci -q delete dhcp.lan.dhcp_option
            for option in $wanted_options; do
                uci add_list dhcp.lan.dhcp_option="$option"
            done
            DHCP_CHANGED=1
        fi
    fi

    [ "$NETWORK_CHANGED" -eq 0 ] || uci commit network || return 1
    [ "$DHCP_CHANGED" -eq 0 ] || uci commit dhcp || return 1
    log "selected gateway=$gw lan_ip=$ip"
}

detect() {
    DEVICE="$(uci -q get network.lan.device || true)"
    [ -n "$DEVICE" ] || DEVICE=br-lan
    command -v arping >/dev/null 2>&1 || log "arping not installed; using weaker IP/neighbour fallback"

    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        log "already running"
        return 0
    fi
    trap cleanup EXIT INT TERM

    current_ip=$(uci -q get network.lan.ipaddr || true)
    current_gw=$(uci -q get network.lan.gateway || true)
    if valid_ipv4 "$current_ip" && valid_ipv4 "$current_gw" && gateway_up "$current_gw"; then
        log "current gateway $current_gw is reachable"
        if configure "$current_gw" "$current_ip"; then
            [ "$DHCP_CHANGED" -eq 0 ] || /etc/init.d/dnsmasq restart >/dev/null 2>&1
        else
            log "failed to refresh DHCP options"
        fi
        return 0
    fi

    # Known consumer-router defaults, ordered from most common to less common.
    GATEWAYS="192.168.1.1 192.168.0.1 192.168.3.1 192.168.31.1 192.168.50.1 192.168.68.1 192.168.100.1"
    for gw in $GATEWAYS; do
        prefix=${gw%.*}
        host=2
        while [ "$host" -le 99 ]; do
            candidate="$prefix.$host"
            if temporary_probe "$gw" "$candidate"; then
                if configure "$gw" "$candidate"; then
                    /etc/init.d/network restart >/dev/null 2>&1
                    /etc/init.d/dnsmasq restart >/dev/null 2>&1
                    return 0
                fi
                log "could not commit configuration for $gw/$candidate"
            fi
            host=$((host + 1))
        done
    done

    log "no known upstream gateway reachable; keeping existing configuration"
    return 1
}

boot() {
    sleep 3
    detect
}

start() { boot; }
